<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WindowsMaintenanceCenter.Tests</RootNamespace>
    <AssemblyName>WindowsMaintenanceCenter.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables; the VSTest adapter runs them as well. -->
    <OutputType>Exe</OutputType>
    <!--
      The .NET 10 SDK does not run Microsoft.Testing.Platform projects through the old VSTest target
      any more ("Testing with VSTest target is no longer supported"). Without this switch `dotnet
      test` fails, and a failing test run must never be turned into a green one by dropping the tests.
    -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only projects that compile and run on every platform: the tests must be runnable in CI and
         on a developer machine, and they must not need Windows, network access or real hardware. -->
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Core\WindowsMaintenanceCenter.Core.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Infrastructure\WindowsMaintenanceCenter.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Maintenance\WindowsMaintenanceCenter.Maintenance.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Reporting\WindowsMaintenanceCenter.Reporting.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Simulation\WindowsMaintenanceCenter.Simulation.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Diagnostics\WindowsMaintenanceCenter.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\WindowsMaintenanceCenter.Hardware\WindowsMaintenanceCenter.Hardware.csproj" />
  </ItemGroup>

</Project>
