<Project>

  <!--
    The version properties live in eng/ and not in build/: directories called "build" are excluded
    from the working snapshots used during development, which silently removed the file and broke
    every project with MSB4019 - twice. "eng" is the usual place for build engineering files in
    .NET repositories and survives.
  -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Version.props" />

  <PropertyGroup>
    <!--
      Windows Maintenance Center is Windows-first (see docs/ARCHITECTURE.md).
      .NET is a machine-wide prerequisite, therefore no implicit tool install is performed.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseArtifactsOutput>false</UseArtifactsOutput>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
    <DebugType>portable</DebugType>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      NU1510: the SDK considers the explicit Microsoft.Win32.Registry reference unnecessary because
      the assembly is provided on net10.0-windows. The reference stays on purpose - it is what makes
      the registry access explicit instead of depending on a framework supply that may differ
      between runtime patches (see docs/BUILD.md, "Registry access").
    -->
    <!--
      CA1716: the parameter names of this domain (module, event, error, step) are English words that
      happen to be reserved in other .NET languages. Renaming them across every interface and call
      site would make the code harder to read, not more correct.
      CA1859: type widening hints for private paths (List<T> instead of IReadOnlyList<T>). The wider
      type is deliberate - it is what keeps the call sites honest about not mutating.
      CA1873: logging arguments are small string interpolations; guarding every one of them would add
      noise without a measurable gain.
      CA1000: Measured<T>.Known/NotAvailable/Missing are the only way to build a measured value, and
      they read as one family. Moving them to a non-generic helper class would touch every call site
      for a style rule about generic types.
    -->
    <NoWarn>$(NoWarn);CA1303;CA1031;CA1848;CA2007;CA1062;CA1416;NU1510;CA1716;CA1859;CA1873;CA1000</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Fail the build on genuinely wrong nullable usage without blocking on style hints. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Company>$(ProductOwner)</Company>
    <Product>$(ProductName)</Product>
    <Description>$(ProductTagline)</Description>
    <Authors>$(ProductOwner)</Authors>
    <IsPackable>false</IsPackable>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ProductTagline" Value="$(ProductTagline)" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="Commit" Value="$(SourceRevisionId)" />
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="BuildTargetFramework" Value="$(TargetFramework)" />
    <AssemblyMetadata Include="BuildRuntimeIdentifier" Value="$(RuntimeIdentifier)" />
    <AssemblyMetadata Include="BuildOnWindows" Value="$(MSBuildRuntimeType)" />
  </ItemGroup>

</Project>
