<UserControl x:Class="WindowsMaintenanceCenter.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsMaintenanceCenter.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Recovery}" />
                <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}" />
                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Recovery_Action_Recover}" Command="{Binding RecoverCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Recovery_Action_Recheck}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_ApprovalRequired}" />
                <TextBlock Text="{Binding ApprovalSummary}" />
                <TextBlock Style="{StaticResource Muted}" Text="{services:Loc Recovery_Hint_Approval}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Action_Approve}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Recovery_Action_Decline}" Command="{Binding DeclineCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Recovery_Section_Result}" />
                <ItemsControl ItemsSource="{Binding ResultLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
