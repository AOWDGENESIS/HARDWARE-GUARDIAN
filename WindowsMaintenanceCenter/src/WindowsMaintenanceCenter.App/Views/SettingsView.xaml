<UserControl x:Class="WindowsMaintenanceCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsMaintenanceCenter.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Appearance}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{services:Loc Field_Language}" Width="180" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{services:Loc Field_Theme}" Width="180" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding LanguageHint}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Behaviour}" />
                <CheckBox Content="{services:Loc Option_SourceChecks}" IsChecked="{Binding UpdateCheckEnabled}" />
                <CheckBox Content="{services:Loc Option_UpdateAtStartup}" IsChecked="{Binding UpdateCheckOnStartup}" />
                <CheckBox Content="{services:Loc Option_VendorSensorTools}" IsChecked="{Binding UseVendorTools}" />
                <CheckBox Content="{services:Loc Option_ManufacturerSources}" IsChecked="{Binding ManufacturerSourcesEnabled}" />
                <CheckBox Content="{services:Loc Option_Telemetry}" IsChecked="{Binding TelemetryEnabled, Mode=OneWay}" IsEnabled="False" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding OfflineHint}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Action_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Privacy}" />
                <CheckBox Content="{services:Loc Option_MaskSerialNumbers}" IsChecked="{Binding MaskSerialNumbers}" />
                <CheckBox Content="{services:Loc Option_MaskUserName}" IsChecked="{Binding MaskUserName}" />
                <CheckBox Content="{services:Loc Option_IncludeEvidence}" IsChecked="{Binding IncludeEvidence}" />
                <TextBlock Style="{StaticResource Muted}" Text="{services:Loc Notice_ReportsStayLocal}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Locations}" />
                <TextBlock Text="{Binding VersionLine}" />
                <TextBlock Text="{Binding EnvironmentLine}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding DataRoot}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding LogDirectory}" />
                <TextBlock Text="{Binding ReportDirectory}" />
                <TextBlock Text="{Binding BackupDirectory}" />
                <TextBlock Text="{Binding AuditLocation}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource BrushBlocked}" Text="{Binding SimulationNotice}"
                           Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Audit}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{services:Loc Action_Reload}" Command="{Binding ReloadAuditCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding RecentAudit}" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{services:Loc Column_Time}" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="150" />
                        <DataGridTextColumn Header="{services:Loc Column_Operation}" Binding="{Binding Operation}" Width="130" />
                        <DataGridTextColumn Header="{services:Loc Column_Category}" Binding="{Binding Category}" Width="110" />
                        <DataGridTextColumn Header="{services:Loc Column_Result}" Binding="{Binding Result}" Width="100" />
                        <DataGridTextColumn Header="{services:Loc Column_Key}" Binding="{Binding OperationKey}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
