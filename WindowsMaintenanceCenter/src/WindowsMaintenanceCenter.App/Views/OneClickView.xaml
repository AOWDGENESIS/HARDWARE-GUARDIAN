<UserControl x:Class="WindowsMaintenanceCenter.App.Views.OneClickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsMaintenanceCenter.App.Services">
    <StackPanel>
        <!-- Control: what may be cleaned, what is left out, and how to start -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_OneClick}" />
                <TextBlock Style="{StaticResource Muted}" Text="{services:Loc OneClick_Hint_Deselect}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                    <Button Content="{services:Loc OneClick_Action_Plan}" Command="{Binding PlanCommand}" />
                    <Button Content="{services:Loc OneClick_Action_Run}" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc OneClick_Action_Cancel}" Command="{Binding CancelCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{services:Loc OneClick_Option_Protected}" IsChecked="{Binding IncludeProtected}" Margin="0,0,16,0" />
                    <CheckBox Content="{services:Loc OneClick_Option_PlanOnly}" IsChecked="{Binding PlanOnly}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{services:Loc OneClick_Hint_PlanOnly}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Foreground="{DynamicResource BrushCritical}" Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Categories: every one can be deselected (M27-S-002) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_Categories}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{services:Loc OneClick_Action_SelectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Content="{services:Loc OneClick_Action_SelectNone}" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" MinWidth="220" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SafetyText}" Style="{StaticResource Muted}" MinWidth="110" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Approval: the run waits for this decision -->
        <Border Style="{StaticResource Card}" Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_ApprovalRequired}" />
                <TextBlock Text="{Binding ApprovalSummary}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Text="{services:Loc OneClick_Hint_Approval}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Action_Approve}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Action_Reject}" Command="{Binding RejectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Plan: named items with risk, size and safety class -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_Plan}" />
                <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PlanLines}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Phases: what ran, why, with which risk and result (M27-S-001, M27-S-003) -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_Steps}" />
                <DataGrid ItemsSource="{Binding Steps}" MaxHeight="330" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_Phase}" Binding="{Binding Phase}" Width="110" />
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_Outcome}" Binding="{Binding Outcome}" Width="110" />
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_Risk}" Binding="{Binding Risk}" Width="90" />
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_What}" Binding="{Binding What}" Width="240" />
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_Why}" Binding="{Binding Why}" Width="260" />
                        <DataGridTextColumn Header="{services:Loc OneClick_Header_Detail}" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Before/after: measured, never assumed (M27-F-001) -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_Measurements}" />
                <ItemsControl ItemsSource="{Binding Measurements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Result: the state it ended in, the open points and the report -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_Report}" />
                <TextBlock Text="{Binding FinalStateText}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc OneClick_Section_OpenPoints}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding OpenPointsText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
