<Window x:Class="WindowsMaintenanceCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsMaintenanceCenter.App.Services"
        Title="{services:Loc Shell_ProductName}"
        Height="820" Width="1320" MinHeight="600" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity, state machine state, scan control, progress -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{services:Loc Shell_ProductName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding EnvironmentLine}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushBlocked}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SimulationNotice}" Foreground="White" FontSize="11" TextWrapping="NoWrap" />
                    </Border>
                    <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StateText}" FontSize="11" TextWrapping="NoWrap" />
                    </Border>
                    <Button Content="{Binding StatusText}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" MinWidth="200" />
                    <Button Content="{services:Loc Action_Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: navigation left, page right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding SelectedPageIndex}" Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TitleKey, Converter={StaticResource Text}}" Padding="6,8" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </Grid>

        <!-- Footer: progress and the live protocol -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <!-- Mode=OneWay is not decoration: ProgressBar.Value inherits RangeBase.Value, whose metadata
                         carries BindsTwoWayByDefault. A binding without a mode therefore demands a settable
                         property, and ProgressPercent belongs to the view model - the first start of the delivered
                         program threw "A TwoWay or OneWayToSource binding cannot work on the read-only property
                         'ProgressPercent'" (run 35697744225). -->
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding StepText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ProblemSummary}" Margin="0,0,8,0" />
                        <Button Content="{services:Loc Action_Clear}" Command="{Binding ClearProtocolCommand}" MinWidth="70" />
                        <Button Content="{services:Loc Action_Protocol}" Command="{Binding ToggleProtocolCommand}" MinWidth="90" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Margin="0,8,0,0" MaxHeight="180"
                        Visibility="{Binding IsProtocolVisible, Converter={StaticResource BoolToVisibility}}">
                    <ListView ItemsSource="{Binding ProtocolEntries}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{services:Loc Column_Time}" Width="150" DisplayMemberBinding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}" />
                                <GridViewColumn Header="{services:Loc Column_Module}" Width="90" DisplayMemberBinding="{Binding Module}" />
                                <GridViewColumn Header="{services:Loc Column_Status}" Width="90" DisplayMemberBinding="{Binding Severity}" />
                                <GridViewColumn Header="{services:Loc Column_Action}" Width="420" DisplayMemberBinding="{Binding Action, Converter={StaticResource Text}}" />
                                <GridViewColumn Header="{services:Loc Column_Detail}" Width="420" DisplayMemberBinding="{Binding Detail}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
