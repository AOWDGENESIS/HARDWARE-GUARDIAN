<UserControl x:Class="WindowsMaintenanceCenter.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsMaintenanceCenter.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Hardware}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Width="260" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Components}" MaxHeight="420">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{services:Loc Column_Category}" Binding="{Binding Category}" Width="130" />
                    <DataGridTextColumn Header="{services:Loc Column_Name}" Binding="{Binding Name}" Width="280" />
                    <DataGridTextColumn Header="{services:Loc Column_Manufacturer}" Binding="{Binding Manufacturer}" Width="150" />
                    <DataGridTextColumn Header="{services:Loc Column_Model}" Binding="{Binding Model}" Width="180" />
                    <DataGridTextColumn Header="{services:Loc Column_Status}" Binding="{Binding StatusText}" Width="90" />
                    <DataGridTextColumn Header="{services:Loc Column_Source}" Binding="{Binding Origin}" Width="90" />
                    <DataGridTextColumn Header="{services:Loc Column_Driver}" Binding="{Binding DriverVersion}" Width="120" />
                    <DataGridTextColumn Header="{services:Loc Column_Signature}" Binding="{Binding Signature}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Details}" />
                <DataGrid ItemsSource="{Binding Details}" MaxHeight="320">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{services:Loc Column_Item}" Binding="{Binding Title}" Width="320" />
                        <DataGridTextColumn Header="{services:Loc Column_Value}" Binding="{Binding Value}" Width="*" />
                        <DataGridTextColumn Header="{services:Loc Column_Source}" Binding="{Binding Origin}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
