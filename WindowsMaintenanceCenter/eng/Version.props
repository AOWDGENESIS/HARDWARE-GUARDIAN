<Project>

  <!--
    Single source of truth for the product version (SemVer, see docs/RELEASE.md).
    Change these values here only - never inside a project file.
  -->
  <PropertyGroup>
    <ProductName>Windows Maintenance Center</ProductName>
    <ProductTagline>Windows Hardware Diagnostics, Maintenance &amp; Update Center</ProductTagline>
    <ProductOwner>AOWDGENESIS</ProductOwner>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Version>$(VersionPrefix)$(VersionSuffix)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) AOWDGENESIS</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryUrl>https://github.com/AOWDGENESIS/Entwicklungen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Build metadata is injected by scripts/build.ps1 -p:SourceRevisionId=... -p:BuildDate=... -->
    <BuildDate Condition="'$(BuildDate)' == ''">unspecified</BuildDate>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
  </PropertyGroup>

</Project>
