# The .NET 10 SDK starts test projects through the Microsoft.Testing.Platform only when the
# repository asks for it. Without this file a manual `dotnet test` would use the old VSTest path,
# which the SDK refuses for xUnit v3 - and the run would fail for a reason that has nothing to do
# with the tests. scripts/test.ps1 does not depend on this file: it starts the test executable.
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
