# Normalise line endings so that hashes and builds are identical on Windows and Linux.
* text=auto eol=lf

*.cs           text eol=lf
*.csproj       text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.sln          text eol=crlf
*.xaml         text eol=lf
*.resx         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.ps1          text eol=lf
*.psm1         text eol=lf
*.iss          text eol=crlf
*.yml          text eol=lf
*.yaml         text eol=lf

# Binary
*.png          binary
*.ico          binary
*.exe          binary
*.dll          binary
*.pdf          binary

# Keep diffs readable for generated release notes
release-notes/*.md linguist-generated=true
