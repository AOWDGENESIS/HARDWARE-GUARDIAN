<UserControl x:Class="HardwareGuardian.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance and language" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Language" Width="180" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Theme" Width="180" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding LanguageHint}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Behaviour" />
                <CheckBox Content="Allow official source checks (off = offline mode)" IsChecked="{Binding UpdateCheckEnabled}" />
                <CheckBox Content="Check for updates at startup" IsChecked="{Binding UpdateCheckOnStartup}" />
                <CheckBox Content="Use vendor tools for sensors" IsChecked="{Binding UseVendorTools}" />
                <CheckBox Content="Allow official manufacturer sources" IsChecked="{Binding ManufacturerSourcesEnabled}" />
                <CheckBox Content="Telemetry (fixed: off)" IsChecked="{Binding TelemetryEnabled, Mode=OneWay}" IsEnabled="False" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding OfflineHint}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy of reports" />
                <CheckBox Content="Mask serial numbers" IsChecked="{Binding MaskSerialNumbers}" />
                <CheckBox Content="Mask user name" IsChecked="{Binding MaskUserName}" />
                <CheckBox Content="Include evidence in reports" IsChecked="{Binding IncludeEvidence}" />
                <TextBlock Style="{StaticResource Muted}" Text="Reports stay on this machine. Nothing is uploaded." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Locations" />
                <TextBlock Text="{Binding VersionLine}" />
                <TextBlock Text="{Binding EnvironmentLine}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding DataRoot}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding LogDirectory}" />
                <TextBlock Text="{Binding ReportDirectory}" />
                <TextBlock Text="{Binding BackupDirectory}" />
                <TextBlock Text="{Binding AuditLocation}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource BrushBlocked}" Text="{Binding SimulationNotice}"
                           Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Audit log" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Reload" Command="{Binding ReloadAuditCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding RecentAudit}" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="150" />
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="130" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="100" />
                        <DataGridTextColumn Header="Key" Binding="{Binding OperationKey}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
