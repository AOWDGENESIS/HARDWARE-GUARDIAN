<UserControl x:Class="HardwareGuardian.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Maintenance" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Select safe items" Command="{Binding SelectSafeCommand}" />
                    <Button Content="Dry run" Command="{Binding DryRunCommand}" />
                    <Button Content="Execute" Command="{Binding ExecuteCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding PlanSummary}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource BrushCritical}" Text="{Binding Message}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Approval required" />
                <TextBlock Text="{Binding ApprovalSummary}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Reject" Command="{Binding RejectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Items" />
                <DataGrid ItemsSource="{Binding Items}" MaxHeight="330">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Safety" Binding="{Binding SafetyClassText}" Width="100" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="Files" Binding="{Binding FileCountText}" Width="90" />
                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding RequiresAdministrator}" Width="60" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Result / evidence" />
                <ItemsControl ItemsSource="{Binding ResultLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
