<UserControl x:Class="HardwareGuardian.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:HardwareGuardian.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Maintenance}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{services:Loc Action_Scan}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Action_SelectSafeItems}" Command="{Binding SelectSafeCommand}" />
                    <Button Content="{services:Loc Action_DryRun}" Command="{Binding DryRunCommand}" />
                    <Button Content="{services:Loc Action_Execute}" Command="{Binding ExecuteCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding PlanSummary}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource BrushCritical}" Text="{Binding Message}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_ApprovalRequired}" />
                <TextBlock Text="{Binding ApprovalSummary}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Action_Approve}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Action_Reject}" Command="{Binding RejectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Items}" />
                <DataGrid ItemsSource="{Binding Items}" MaxHeight="330">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{services:Loc Column_Use}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <DataGridTextColumn Header="{services:Loc Column_Item}" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="{services:Loc Column_Safety}" Binding="{Binding SafetyClassText}" Width="100" />
                        <DataGridTextColumn Header="{services:Loc Column_Size}" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="{services:Loc Column_Files}" Binding="{Binding FileCountText}" Width="90" />
                        <DataGridCheckBoxColumn Header="{services:Loc Column_Admin}" Binding="{Binding RequiresAdministrator}" Width="60" />
                        <DataGridTextColumn Header="{services:Loc Column_Description}" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_ResultEvidence}" />
                <ItemsControl ItemsSource="{Binding ResultLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
