<UserControl x:Class="HardwareGuardian.App.Views.WindowsHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Windows state" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Check (online allowed)" Command="{Binding AssessCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Check (offline)" Command="{Binding AssessOfflineCommand}" />
                    <Button Content="DISM scan" Command="{Binding DismScanCommand}" />
                    <Button Content="DISM repair" Command="{Binding DismRepairCommand}" />
                    <Button Content="SFC" Command="{Binding SfcCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding OverallStatus, Converter={StaticResource StatusBrush}}" CornerRadius="4" Padding="10,3" Margin="0,0,10,0">
                        <TextBlock Text="{Binding OverallStatus}" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ElevationHint}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" Foreground="{DynamicResource BrushAttention}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Details" />
                <TextBlock Text="{Binding DefenderText}" />
                <TextBlock Text="{Binding UpdateText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PendingRebootText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Checks" />
                <DataGrid ItemsSource="{Binding Checks}" MaxHeight="380">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="230" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                        <DataGridTextColumn Header="Performed" Binding="{Binding Performed}" Width="80" />
                        <DataGridTextColumn Header="Admin" Binding="{Binding RequiresAdministrator}" Width="70" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary, Converter={StaticResource Text}}" Width="340" />
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
