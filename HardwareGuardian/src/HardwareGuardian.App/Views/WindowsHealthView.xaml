<UserControl x:Class="HardwareGuardian.App.Views.WindowsHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:HardwareGuardian.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_WindowsState}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{services:Loc Action_CheckOnline}" Command="{Binding AssessCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Action_CheckOffline}" Command="{Binding AssessOfflineCommand}" />
                    <Button Content="{services:Loc Action_DismScan}" Command="{Binding DismScanCommand}" />
                    <Button Content="{services:Loc Action_DismRepair}" Command="{Binding DismRepairCommand}" />
                    <Button Content="{services:Loc Action_SfcVerify}" Command="{Binding SfcVerifyCommand}" ToolTip="{services:Loc Sfc_Verify_Tooltip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding OverallStatus, Converter={StaticResource StatusBrush}}" CornerRadius="4" Padding="10,3" Margin="0,0,10,0">
                        <TextBlock Text="{Binding OverallStatus}" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ElevationHint}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" Foreground="{DynamicResource BrushAttention}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsAwaitingRepairApproval, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_ApprovalRequired}" />
                <TextBlock Text="{Binding RepairApprovalSummary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{services:Loc Action_Approve}" Command="{Binding ApproveRepairCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{services:Loc Action_Reject}" Command="{Binding RejectRepairCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Details}" />
                <TextBlock Text="{Binding DefenderText}" />
                <TextBlock Text="{Binding UpdateText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PendingRebootText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{services:Loc Section_Checks}" />
                <DataGrid ItemsSource="{Binding Checks}" MaxHeight="380">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{services:Loc Column_Check}" Binding="{Binding Title}" Width="230" />
                        <DataGridTextColumn Header="{services:Loc Column_Status}" Binding="{Binding StatusText}" Width="90" />
                        <DataGridTextColumn Header="{services:Loc Column_Performed}" Binding="{Binding Performed}" Width="80" />
                        <DataGridTextColumn Header="{services:Loc Column_Admin}" Binding="{Binding RequiresAdministrator}" Width="70" />
                        <DataGridTextColumn Header="{services:Loc Column_Summary}" Binding="{Binding Summary, Converter={StaticResource Text}}" Width="340" />
                        <DataGridTextColumn Header="{services:Loc Column_Evidence}" Binding="{Binding Evidence}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
