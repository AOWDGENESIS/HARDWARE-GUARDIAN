<UserControl x:Class="HardwareGuardian.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:HardwareGuardian.App.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding OverallSummary, Converter={StaticResource Text}}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="{Binding OverallStatus, Converter={StaticResource StatusBrush}}" CornerRadius="4" Padding="10,3" Margin="0,0,10,0">
                        <TextBlock Text="{Binding OverallStatus}" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding CountsLine}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ComponentCountText}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding LastScanText}" />
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource BrushCritical}" Text="{Binding Message}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Reports" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Report JSON" Command="{Binding ReportJsonCommand}" />
                    <Button Content="Report TXT" Command="{Binding ReportTextCommand}" />
                    <Button Content="Report HTML" Command="{Binding ReportHtmlCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Findings" />
                <DataGrid ItemsSource="{Binding Problems}" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title, Converter={StaticResource Text}}" Width="280" />
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Sensors" />
                <DataGrid ItemsSource="{Binding Sensors}" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reading" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="100" />
                        <DataGridTextColumn Header="Measurement point" Binding="{Binding MeasurementPoint}" Width="240" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Origin}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Modules" />
                <DataGrid ItemsSource="{Binding Modules}" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Checks" Binding="{Binding Checks}" Width="80" />
                        <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds}" Width="80" />
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
