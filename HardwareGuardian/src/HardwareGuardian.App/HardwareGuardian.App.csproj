<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>HardwareGuardian.App</RootNamespace>
    <AssemblyName>HardwareGuardian</AssemblyName>
    <ApplicationIcon />
    <Product>Hardware Guardian</Product>
    <AssemblyTitle>Hardware Guardian</AssemblyTitle>
    <Description>Windows hardware diagnostics, maintenance and update centre.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HardwareGuardian.Core\HardwareGuardian.Core.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Infrastructure\HardwareGuardian.Infrastructure.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Hardware\HardwareGuardian.Hardware.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Diagnostics\HardwareGuardian.Diagnostics.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Sensors\HardwareGuardian.Sensors.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Drivers\HardwareGuardian.Drivers.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Bios\HardwareGuardian.Bios.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Security\HardwareGuardian.Security.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Manufacturer\HardwareGuardian.Manufacturer.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Maintenance\HardwareGuardian.Maintenance.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Reporting\HardwareGuardian.Reporting.csproj" />
    <ProjectReference Include="..\HardwareGuardian.Windows\HardwareGuardian.Windows.csproj" />
    <!-- The simulation fixture is compiled in on purpose: it is the only way to show the UI on a
         machine without Windows hardware access, and every value it produces is labelled as
         simulation. It is never selected automatically. -->
    <ProjectReference Include="..\HardwareGuardian.Simulation\HardwareGuardian.Simulation.csproj" />
  </ItemGroup>

</Project>
