<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark is the default theme (spec section 40). Colours live only here, never in a view. -->
    <Color x:Key="ColorBackground">#FF16171A</Color>
    <Color x:Key="ColorSurface">#FF1F2126</Color>
    <Color x:Key="ColorSurfaceAlt">#FF272A31</Color>
    <Color x:Key="ColorBorder">#FF3A3E47</Color>
    <Color x:Key="ColorForeground">#FFECEDEF</Color>
    <Color x:Key="ColorMuted">#FF9AA0AA</Color>
    <Color x:Key="ColorAccent">#FF4C9AFF</Color>
    <Color x:Key="ColorHealthy">#FF4CC38A</Color>
    <Color x:Key="ColorAttention">#FFE3B341</Color>
    <Color x:Key="ColorWarning">#FFE38A41</Color>
    <Color x:Key="ColorCritical">#FFE5484D</Color>
    <Color x:Key="ColorBlocked">#FFA78BFA</Color>
    <Color x:Key="ColorUnknown">#FF8B8B94</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushForeground" Color="{StaticResource ColorForeground}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushHealthy" Color="{StaticResource ColorHealthy}" />
    <SolidColorBrush x:Key="BrushAttention" Color="{StaticResource ColorAttention}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushCritical" Color="{StaticResource ColorCritical}" />
    <SolidColorBrush x:Key="BrushBlocked" Color="{StaticResource ColorBlocked}" />
    <SolidColorBrush x:Key="BrushUnknown" Color="{StaticResource ColorUnknown}" />
</ResourceDictionary>
